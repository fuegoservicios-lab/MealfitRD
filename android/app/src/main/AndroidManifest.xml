<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- [P1-PLAN-LOTE-156 · 2026-09-22] `adjustResize` EXPLÍCITO.
             Sin declararlo, Android usa `ADJUST_UNSPECIFIED` y «el sistema intenta elegir» entre
             encoger la ventana o desplazarla. Toda la coreografía del teclado del chat (lotes
             111/115/128/131/138) se apoya en `window.visualViewport`, y ese objeto solo encoge
             si la ventana ENCOGE; si el sistema decide desplazar, la web no se entera de que hay
             teclado. En iOS no se nota porque el binario retransmite `keyboardWillShow` desde
             SceneDelegate.swift — en Android ese aviso no existe: el MainActivity es el
             BridgeActivity pelado, así que la geometría es la única fuente que hay.
             Si el sistema ya venía eligiendo `resize`, esto no cambia nada; si elegía desplazar,
             arregla la caja de escribir tapada. No viaja por OTA: exige un APK nuevo. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- [P1-PLAN-LOTE-280 · 2026-09-25] La push de Firebase: icono en silueta (res/drawable/ic_stat_bioboros.xml),
             el índigo de la marca y el canal de prioridad alta de los recordatorios (lo crea la app al arrancar). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_bioboros" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bioboros-avisos" />
    </application>

    <!-- [P1-PLAN-LOTE-683 · 2026-09-28] Voz: desde Android 11 (API 30) una app solo VE los servicios del sistema que
         declara aquí. Sin estas dos consultas, el reconocedor de voz (RecognitionService, el de la app de Google) y el
         motor de TextToSpeech existen en el teléfono pero la app no los encuentra: `available()` diría que no hay voz.
         RECORD_AUDIO no va aquí: lo declara su propio plugin (@capgo/capacitor-speech-recognition). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Capacitor's WebChromeClient grants WebRTC audio only if BOTH permissions
         are granted: RECORD_AUDIO (from SpeechRecognition) and MODIFY_AUDIO_SETTINGS.
         Without the latter getUserMedia fails with NotAllowedError even while
         native dictation works. This normal permission requires a new APK. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- [P1-PLAN-LOTE-152 · 2026-09-21] Solo van AQUÍ los permisos que ningún plugin declara por su cuenta.
         Capacitor fusiona el manifiesto de cada plugin con éste, así que repetirlos sería ruido que luego
         nadie sabe si se puede quitar. Ya los traen sus dueños:
           · @capacitor/local-notifications → POST_NOTIFICATIONS, SCHEDULE_EXACT_ALARM, RECEIVE_BOOT_COMPLETED,
             WAKE_LOCK (los avisos de comida y agua, que en la app nativa se programan en el teléfono).
           · @capacitor/haptics → VIBRATE.
         @capacitor/camera NO trae manifiesto: sus permisos son estos tres y son nuestros.

         READ_MEDIA_IMAGES y READ_EXTERNAL_STORAGE son la MISMA necesidad en dos épocas de Android: elegir una
         foto de la galería para el escáner. Desde Android 13 (API 33) el permiso viejo ya no se concede, y por
         eso el viejo lleva `maxSdkVersion="32"`: sin ese tope, Play lo marca como permiso amplio innecesario.
         No pedimos WRITE_EXTERNAL_STORAGE: la app no guarda nada en la galería (en iOS sí existe
         NSPhotoLibraryAddUsageDescription, pero es para el mismo caso que aquí no aplica). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- La cámara es OPCIONAL: sin esto, Play Store esconde la app a las tablets sin cámara, y el escáner es
         una función más del contador, no la app entera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
