# [P1-IOS-CODEMAGIC 2026-08-22] Entorno del BINARIO iOS (`vite build --mode native`).
#
# Deriva de .env.production con dos diferencias, y las dos son deliberadas:
#   - VITE_API_BASE_URL ABSOLUTA. La app vive en capacitor://localhost: una ruta
#     relativa `/api` apunta a la nada. Contrato P2-API-BASE-CONTRACT (config/api.ts).
#   - SIN claves de la pasarela de pago. El gate de plataforma (config/platform.js) ya esconde el
#     comercio; no tener los IDs en el binario es defensa en profundidad (Apple 3.1.1).
#
# Solo VITE_* publicas, como .env.production. Los secretos viven en backend/.env.
# Sign in with Apple se enciende aqui (VITE_AUTH_APPLE_ENABLED=true) cuando el
# provider este configurado en Neon Auth — no antes: un boton que falla es peor
# que ninguno.

VITE_API_BASE_URL=https://app.bioboros.com

# Vacias A PROPOSITO, no ausentes. Vite carga `.env` (el de dev, ignorado por git)
# ANTES que `.env.native`, y el de dev SI trae los IDs de la pasarela: medido el
# 2026-08-22, el bundle nativo construido en local los llevaba dentro. Confiar en que
# en la Mac `.env` no exista es confiar en una ausencia. Un valor vacio PISA al de
# dev y el guard de sanidad del pipeline (codemagic.yaml) lo comprueba en el bundle.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_BASIC=
VITE_PAYPAL_PLAN_PLUS=
VITE_PAYPAL_PLAN_ULTRA=
VITE_PAYPAL_PLAN_BASIC_ANNUAL=
VITE_PAYPAL_PLAN_PLUS_ANNUAL=
VITE_PAYPAL_PLAN_ULTRA_ANNUAL=
VITE_NEON_AUTH_URL=https://ep-divine-sun-aiaszh9z.neonauth.c-4.us-east-1.aws.neon.tech/neondb/auth
VITE_SENTRY_DSN=https://4b132788bcca5aaff5273e31c919be60@o4511722960781312.ingest.us.sentry.io/4511722995384320
VITE_POSTHOG_KEY=phc_kjuhyo2W4dTWa2ZUY36WWxTVuGo7D5NuFQJW27w6wQSr
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_VAPID_PUBLIC_KEY=BKpYCoeaqENz6ie-K6-FuDDjef0jTerQBFAqE-2RUv-ZWVRuoR27QTliWNbM-9xpFnXLZPMmvdQkLF7ahA1lGpM
